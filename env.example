# ---------------------------------------------------------------------------
# LAYER — environment variables
# ---------------------------------------------------------------------------
# The core product is fully local-first: it works with NO environment
# variables set and NO API keys. Copy this file to `.env.local` only if you
# want to customise the optional build-time details below.
#
# NEVER put a secret in a NEXT_PUBLIC_* variable: everything prefixed with
# NEXT_PUBLIC_ is inlined into the client bundle and is publicly readable.

# Cosmetic: version string shown in Settings → About. Defaults to "0.1.0".
NEXT_PUBLIC_LAYER_VERSION=0.1.0

# Optional: canonical origin used for document metadata (og:url, manifest hints).
# It is never called at runtime and never reveals anything about the user.
# Set it on Vercel to the deployment URL; leave it unset locally.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Future / optional integrations — NOT used by the MVP.
# These are documented so that whoever adds them later puts them in the right
# place: server-side only, no NEXT_PUBLIC_ prefix.
# ---------------------------------------------------------------------------
# LAYER_SUPABASE_URL=
# LAYER_SUPABASE_ANON_KEY=
# LAYER_SYNC_ENCRYPTION_KEY=
